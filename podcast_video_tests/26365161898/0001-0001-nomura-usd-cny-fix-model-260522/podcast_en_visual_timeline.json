    "end": 13.502,
    "voice_id": "XZEfcFyBnzsNJrdvkWdI",
    "tts_engine": "elevenlabs",
    "highlight_terms": [
      "PBOC",
      "fix",
      "USDCNY"
    ],
    "page_index": 1,
    "page_count": 1
  },
  {
    "speaker": "EN_B",
    "text": "Right. This report from Nomura’s\nAsia FX strategy team gives us\ntheir model projection. The fix\ncame in at 6. 7979,",
