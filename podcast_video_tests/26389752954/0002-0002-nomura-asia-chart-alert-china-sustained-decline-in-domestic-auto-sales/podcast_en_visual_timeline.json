    "page_index": 1,
    "page_count": 1
  },
  {
    "speaker": "EN_A",
    "text": "But I know exports have been a\nbright spot. Is that helping to\noffset the weakness?",
    "start": 53.07,
    "end": 57.017,
    "voice_id": "XZEfcFyBnzsNJrdvkWdI",
    "tts_engine": "elevenlabs",
    "highlight_terms": [
