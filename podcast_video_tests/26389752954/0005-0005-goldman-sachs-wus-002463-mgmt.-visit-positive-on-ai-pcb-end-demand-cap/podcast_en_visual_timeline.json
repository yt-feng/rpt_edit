    "highlight_terms": [
      "China tech tour",
      "WUS"
    ],
    "page_index": 1,
    "page_count": 1
  },
  {
    "speaker": "EN_B",
    "text": "Right, WUS is a major PCB\nmanufacturer, and we hosted their\nmanagement in Shanghai recently.",
    "start": 11.773,
    "end": 17.253,
    "voice_id": "bdt3B5N3GXM2nOc0SUW7",
