    "end": 47.056,
    "voice_id": "XZEfcFyBnzsNJrdvkWdI",
    "tts_engine": "elevenlabs",
    "highlight_terms": [
      "PCB demand"
    ],
    "page_index": 1,
    "page_count": 1
  },
  {
    "speaker": "EN_B",
    "text": "For one, the specifications are\nupgrading. We’re seeing better\nmaterials and higher layer counts\nto support high-speed connections.",
