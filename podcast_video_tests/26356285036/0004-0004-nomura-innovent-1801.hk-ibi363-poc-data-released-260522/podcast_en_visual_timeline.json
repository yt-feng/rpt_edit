    "end": 21.641,
    "voice_id": "bdt3B5N3GXM2nOc0SUW7",
    "tts_engine": "elevenlabs",
    "highlight_terms": [
      "Nomura report",
      "Innovent",
      "IBI363"
    ],
    "page_index": 1,
    "page_count": 2
  },
  {
    "speaker": "EN_B",
    "text": "cell lung cancer, or NSCLC,",
    "start": 21.641,
    "end": 27.005,
    "voice_id": "bdt3B5N3GXM2nOc0SUW7",
    "tts_engine": "elevenlabs",
    "highlight_terms": [
      "Nomura report",
      "Innovent",
      "IBI363"
    ],
    "page_index": 2,
    "page_count": 2
  },
  {
    "speaker": "EN_B",
    "text": "looks quite promising, especially\nin two tough settings.",
    "start": 27.365,
    "end": 30.384,
    "voice_id": "bdt3B5N3GXM2nOc0SUW7",
    "tts_engine": "elevenlabs",
    "highlight_terms": [
      "promising",
      "tough settings"
    ],
    "page_index": 1,
    "page_count": 1
  },
  {
    "speaker": "EN_A",
    "text": "Two settings—first-line treatment\nand IO-resistant. Which one is the\nreal headline grabber?",
