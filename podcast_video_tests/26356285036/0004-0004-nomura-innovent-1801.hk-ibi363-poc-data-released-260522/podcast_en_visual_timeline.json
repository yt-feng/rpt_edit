    "tts_engine": "elevenlabs",
    "highlight_terms": [
      "sub-group",
      "dosing schedule",
      "3 mg per kg"
    ],
    "page_index": 2,
    "page_count": 2
  },
  {
    "speaker": "EN_B",
    "text": "That group showed an objective\nresponse rate of 86. 4%.",
    "start": 78.392,
