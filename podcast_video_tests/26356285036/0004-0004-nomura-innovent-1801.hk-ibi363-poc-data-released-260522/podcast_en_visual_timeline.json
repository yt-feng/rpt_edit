    "voice_id": "bdt3B5N3GXM2nOc0SUW7",
    "tts_engine": "elevenlabs",
    "highlight_terms": [
      "objective response rate"
    ],
    "page_index": 1,
    "page_count": 1
  },
  {
    "speaker": "EN_A",
    "text": "That’s really high. But I imagine\nthere’s a catch, or at least some\ncaveats.",
