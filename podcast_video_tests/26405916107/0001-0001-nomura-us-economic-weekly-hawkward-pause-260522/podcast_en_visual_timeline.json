    "tts_engine": "elevenlabs",
    "highlight_terms": [
      "Fed chair",
      "Kevin Warsh",
      "cut rates"
    ],
    "page_index": 1,
    "page_count": 1
  },
  {
    "speaker": "EN_B",
    "text": "The report suggests he might be\ninclined to ease, but\npolicy-related pressure has eased.\nPresident Trump recently said",
