    "end": 39.022,
    "voice_id": "XZEfcFyBnzsNJrdvkWdI",
    "tts_engine": "elevenlabs",
    "highlight_terms": [
      "easing bias"
    ],
    "page_index": 1,
    "page_count": 1
  },
  {
    "speaker": "EN_B",
    "text": "Support for that bias has waned.\nThe April FOMC minutes show fewer\nofficials advocating for cuts.\nEven dovish members like Governor",
    "start": 39.382,
    "end": 43.77,
    "voice_id": "bdt3B5N3GXM2nOc0SUW7",
    "tts_engine": "elevenlabs",
    "highlight_terms": [
      "April FOMC minutes",
      "fewer officials",
      "cuts"
    ],
    "page_index": 1,
    "page_count": 2
  },
  {
    "speaker": "EN_B",
    "text": "Waller have turned cautious,",
    "start": 43.77,
    "end": 48.159,
    "voice_id": "bdt3B5N3GXM2nOc0SUW7",
    "tts_engine": "elevenlabs",
    "highlight_terms": [
