name = "kc-desk-notes-worker"
main = "src/index.js"
compatibility_date = "2026-05-01"

[vars]
R2_OBJECT_PREFIX = "reports"
# Set these to the GitHub Pages URLs after deployment.
CATALOG_URL = "https://YOUR_GITHUB_PAGES_HOST/rpt_edit/data/catalog.json"
PASSWORD_RULES_URL = "https://YOUR_GITHUB_PAGES_HOST/rpt_edit/data/password_rules.json"
ALLOWED_ORIGIN = "https://YOUR_GITHUB_PAGES_HOST"
# Reportify module: lets a gated-report click trigger the reportify-grab workflow.
# GH_DISPATCH_TOKEN is a fine-grained PAT with Actions: read/write on this repo
# (set it as a secret: `wrangler secret put GH_DISPATCH_TOKEN`).
GH_REPO = "yt-feng/rpt_edit"
# Optional for custom topic plans and story narratives:
# wrangler secret put DEEPSEEK_API_KEY
# DEEPSEEK_BASE_URL = "https://api.deepseek.com"
# DEEPSEEK_MODEL = "deepseek-chat"
# Optional for scheduled Newsfeed digest emails via Resend:
# wrangler secret put RESEND_API_KEY
# NEWSFEED_EMAIL_FROM = "KC Desk Newsfeed <newsfeed@kcdesk.com>"
# Or use Cloudflare Email Service by setting NEWSFEED_EMAIL_PROVIDER = "cloudflare"
# and adding a send_email binding:
# [[send_email]]
# name = "EMAIL"
# remote = true

[triggers]
crons = ["*/30 * * * *"]

[[r2_buckets]]
binding = "REPORT_BUCKET"
bucket_name = "kc-desk-notes-pdfs"
