  "source_preview_html": "<html><head><title>Taxing Better to Boost Growth </title><meta name=\"og:title\" content=\"Taxing Better to Boost Growth \"><meta name=\"parsely-title\" content=\"Taxing Better to Boost Growth \"><meta name=\"og:url\" content=\"https://www.imf.org/en/publications/fm/issues/2026/10/05/fiscal-monitor-october-2026\"><meta name=\"parsely-link\" content=\"https://www.imf.org/en/publications/fm/issues/2026/10/05/fiscal-monitor-october-2026\"><meta name=\"language\" content=\"ENG\"><meta name=\"creator\" content=\"International Monetary Fund\"><meta name=\"date\" content=\"2026-10-05\"><meta name=\"description\" content=\"Chapter 1 Fiscal Monitor recommends that taxing better can support growth without sacrificing revenue. The chapter shows how reducing tax distortions—through more neutral VAT and corporate tax design, stronger work incentives, better-targeted innovation support, and stronger tax administration—can raise investment, employment, productivity, and economic efficiency. \"><link rel=\"canonical\" href=\"https://www.imf.org/en/publications/fm/issues/2026/10/05/fiscal-monitor-october-2026\"></head><body><h1>Fiscal Monitor</h1></body></html>",
