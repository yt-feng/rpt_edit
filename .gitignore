*.pyc
.env
mineru_result.zip
.DS_Store
_portal_suite_pages/
_neutral_site/
.neutral_edge_runtime/
workers/portal-suite-worker/wrangler.toml
# Transient institution-source PDFs: only an input for the WeChat pipeline.
# We keep the original PDF link in institution_feeds/, never the PDF itself.
_institution_latest_pdfs/
_consulting_latest_pdfs/
workers/portal-suite-worker/.wrangler/
# Market Views synthesis internals remain runner-only. The daily workflow
# explicitly force-adds only the public-safe market_views_<date>.pdf after the
# private ending page has been removed; JSON, prompts, figures and logs stay ignored.
market_view_summaries/

# Generated publishing outputs live in private storage or ephemeral CI only.
xhs_notes/
publish_ready_zips/
portal_translated_reports/
wechat_drafts/
bilingual_podcast_videos/
podcast_video_tests/

# Decrypted only inside the deployment runner.
portal_suite/site_src/assets/contact-card.jpg
portal_suite/site_src/assets/social-card.jpg

# The member-course source index, mapping, keys, and plaintext catalog stay
# local. Only the authenticated AES-256-GCM envelope may be tracked.
.course-directory/*
!.course-directory/*.aesgcm
