        },
        {
            "type": "title",
            "content": {
                "title_content": [
                    {
                        "type": "text",
                        "content": "Biopharma Carve-Outs Are Tricky. Here's How to Get Them Right."
                    }
                ],
                "level": 1
            },
            "bbox": [
                42,
                510,
                799,
                661
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "By Hob Brooks, Ben Aylor, Megan DeFauw, Chrissy O'Brien, and André Kronimus"
                    }
                ]
            },
            "bbox": [
                40,
                689,
                713,
                708
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "ARTICLE FEBRUARY 28, 2022"
                    }
                ]
            },
            "bbox": [
                40,
                733,
                284,
                749
            ]
        },
        {
            "type": "page_footer",
            "content": {
                "page_footer_content": [
                    {
                        "type": "text",
