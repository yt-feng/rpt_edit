                0.917,
                0.6
            ],
            "angle": 0,
            "content": "Noncore segment acquisition"
        },
        {
            "type": "paragraph_title",
            "bbox": [
                0.056,
                0.604,
                0.409,
                0.612
            ],
            "angle": 0,
            "content": "EXPERIENCE MATTERS, A"
        },
        {
            "type": "paragraph_title",
            "bbox": [
                0.059,
                0.611,
                0.41,
                0.638
            ],
            "angle": 0,
            "content": "LOT, WHEN IT COMES TO\nCREATING VALUE FROM\nWEAK-ECONOMY DEALS"
        },
        {
            "type": "text",
            "bbox": [
                0.07,
                0.641,
                0.41,
                0.671
            ],
            "angle": 0,
            "content": "In a downturn, experienced buyers create significantly more value from M&A than occasional buyers: 2-year RTSR of 7.3% for experienced versus 1.4% for occasional",
            "merge_prev": false
        },
        {
            "type": "image_footnote",
            "bbox": [
                0.54,
                0.615,
                0.677,
                0.622
            ],
            "angle": 0,
            "content": "2-YEAR RTSR (%)"
        },
