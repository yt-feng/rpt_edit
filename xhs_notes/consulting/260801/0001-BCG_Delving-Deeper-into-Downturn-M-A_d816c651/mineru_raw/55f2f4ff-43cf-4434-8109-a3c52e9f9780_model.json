            "content": "Year 2"
        },
        {
            "type": "paragraph_title",
            "bbox": [
                0.121,
                0.509,
                0.41,
                0.525
            ],
            "angle": 0,
            "content": "BOLDNESS PAYS OFF,\nAS DOWNTURN"
        },
        {
            "type": "text",
            "bbox": [
                0.092,
                0.555,
                0.411,
                0.585
            ],
            "angle": 0,
            "content": "In a weak economy, noncore deals (acquisitions outside the buyer's industry) create more value than core deals: 1-year RTSR is 3.9 percentage points higher",
            "merge_prev": false
        },
        {
            "type": "image_footnote",
            "bbox": [
                0.539,
                0.52,
                0.676,
                0.527
            ],
            "angle": 0,
            "content": "1-YEAR RTSR (%)"
        },
