        ],
        "page_idx": 7
    },
    {
        "type": "page_number",
        "text": "8",
        "bbox": [
            916,
            963,
            929,
            977
        ],
        "page_idx": 7
    },
    {
        "type": "text",
        "text": "Notably small island developing States depend heavily on oil imports.",
        "text_level": 1,
        "bbox": [
            158,
            62,
            918,
            155
        ],
        "page_idx": 8
    },
    {
        "type": "text",
        "text": "Net imports of oil and petroleum products as a share of GDP, average for the period 2022-2024",
        "bbox": [
            63,
            170,
            827,
            240
        ],
        "page_idx": 8
    },
    {
        "type": "chart",
        "img_path": "images/0cd68e5146004b56c2b746cb0709a5b2504f151698199acdca8af03b6d42b7c9.jpg",
        "content": "",
        "chart_caption": [],
        "chart_footnote": [
