        "bbox": [
            916,
            962,
            930,
            978
        ],
        "page_idx": 2
    },
    {
        "type": "text",
        "text": "The prospect of the Strait opening is calming energy markets down.",
        "text_level": 2,
        "bbox": [
            158,
            62,
            877,
            156
        ],
        "page_idx": 3
    },
    {
        "type": "image",
