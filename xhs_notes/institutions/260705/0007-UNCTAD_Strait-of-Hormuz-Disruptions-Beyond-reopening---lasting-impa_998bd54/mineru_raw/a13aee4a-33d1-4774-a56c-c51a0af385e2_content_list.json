    },
    {
        "type": "page_number",
        "text": "4",
        "bbox": [
            916,
            963,
            930,
            977
        ],
        "page_idx": 3
    },
    {
        "type": "text",
        "text": "But in some sectors, such as transport, prices take longer to adjust.",
        "text_level": 1,
        "bbox": [
            158,
            63,
            931,
            155
        ],
        "page_idx": 4
    },
    {
        "type": "text",
        "text": "IGC Grains and oilseeds freight index (GOFI), 1 Jan 2013 = 100",
        "bbox": [
            63,
            175,
            855,
            209
        ],
        "page_idx": 4
    },
    {
        "type": "chart",
        "img_path": "images/1dfcb8065721eb8e5e4f3063be5bd57689d258b41bdac240e8cf0152bbb012ac.jpg",
        "content": "",
        "chart_caption": [],
        "chart_footnote": [
