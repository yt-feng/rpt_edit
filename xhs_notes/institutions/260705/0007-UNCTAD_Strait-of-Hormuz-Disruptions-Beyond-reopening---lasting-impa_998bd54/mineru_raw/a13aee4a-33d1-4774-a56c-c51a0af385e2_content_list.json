        ],
        "page_idx": 8
    },
    {
        "type": "page_number",
        "text": "9",
        "bbox": [
            916,
            962,
            929,
            978
        ],
        "page_idx": 8
    },
    {
        "type": "text",
        "text": "For many least developed countries imports of staple food are crucial.",
        "text_level": 2,
        "bbox": [
            158,
            62,
            862,
            154
        ],
        "page_idx": 9
    },
    {
        "type": "text",
