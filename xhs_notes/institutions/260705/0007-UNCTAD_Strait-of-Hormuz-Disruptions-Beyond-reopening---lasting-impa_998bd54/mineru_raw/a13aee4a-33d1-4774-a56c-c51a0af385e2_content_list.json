        "image_caption": [],
        "image_footnote": [],
        "content": "",
        "bbox": [
            80,
            168,
            127,
            220
        ],
        "page_idx": 3
    },
    {
        "type": "text",
        "text": "Daily price of crude oil in US\\$ per barrel",
        "text_level": 2,
        "bbox": [
            158,
            175,
            661,
            210
        ],
        "page_idx": 3
    },
    {
        "type": "chart",
        "img_path": "images/d32055306f522cec27e57ad1e98b9279c2c2526b91ca5ea89599916b7e34c3a1.jpg",
        "content": "",
        "chart_caption": [],
        "chart_footnote": [
