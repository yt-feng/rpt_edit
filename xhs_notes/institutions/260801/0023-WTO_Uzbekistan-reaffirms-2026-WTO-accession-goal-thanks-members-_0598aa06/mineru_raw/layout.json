                            "spans": [
                                {
                                    "bbox": [
                                        52,
                                        635,
                                        541,
                                        678
                                    ],
                                    "type": "text",
                                    "content": "Uzbekistan remains fully committed to working intensively and constructively with every Member to achieve this objective in 2026."
                                }
                            ]
                        }
                    ],
                    "index": 6,
                    "merge_prev": false
                }
