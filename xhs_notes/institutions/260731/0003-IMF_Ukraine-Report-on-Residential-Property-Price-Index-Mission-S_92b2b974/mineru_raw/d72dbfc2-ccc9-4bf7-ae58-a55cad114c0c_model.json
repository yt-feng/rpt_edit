            "bbox": [
                0.122,
                0.747,
                0.766,
                0.764
            ],
            "angle": 0,
            "content": "Keywords: Residential Real Estate, Price Index, Financial Stability, Macroprudential Analysis",
            "merge_prev": false
        },
