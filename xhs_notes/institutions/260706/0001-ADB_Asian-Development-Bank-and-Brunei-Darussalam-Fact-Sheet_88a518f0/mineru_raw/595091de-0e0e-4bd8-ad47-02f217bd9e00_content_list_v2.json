            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "BRUNEI DARUSSALAM: SHAREHOLDING AND VOTING POWER"
                    }
                ]
            },
            "bbox": [
                630,
                275,
                916,
                305
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "Number of shares held: 37,386 (0.351% of total shares)"
                    }
                ]
            },
            "bbox": [
                632,
                309,
                808,
                335
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "Votes:\n75,933 (0.571% of total membership,\n0.872% of total regional membership)"
                    }
                ]
            },
            "bbox": [
                632,
                338,
                844,
                376
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "*Overall capital subscription: $512.45 million"
                    }
                ]
            },
            "bbox": [
                632,
                378,
                818,
                404
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "*Paid-in capital subscription: $25.67 million"
                    }
                ]
            },
            "bbox": [
                632,
                407,
                816,
                433
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "*United States dollar figures are valued at the rate as of 31 December 2025."
                    }
                ]
