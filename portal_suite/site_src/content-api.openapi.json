{
  "openapi": "3.1.0",
  "info": {
    "title": "KC桌面 Content API",
    "version": "1.1.0",
    "description": "Read-only authorized content. Account-wide daily request/byte limits are operational limits, not billing meters. Each scope can be granted independently. Not every report has all materials."
  },
  "servers": [
    {
      "url": "https://kcdesk.com/api/content/v1"
    }
  ],
  "security": [
    {
      "ApiKey": []
    }
  ],
  "paths": {
    "/reports": {
      "get": {
        "operationId": "searchReports",
        "summary": "List or search authorized titles and institutions",
        "description": "Requires reports:read. Reads existing published content only; no new generation.",
        "x-required-scope": "reports:read",
        "parameters": [
          {
            "name": "cursor",
            "description": "Opaque cursor; preserve filters.",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          },
          {
            "name": "limit",
            "description": "Rows per page.",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "q",
            "description": "NFKC, whitespace and case normalized; at most 200 normalized Unicode characters. Not full-text/semantic search.",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 800
            }
          },
          {
            "name": "date",
            "description": "Exact source date, not update time.",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "items",
                    "next_cursor"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Report"
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Authorization, input, content or quota error; Retry-After may be present.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "error"
                  ],
                  "properties": {
                    "ok": {
                      "const": false
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/reports/{id}": {
      "get": {
        "operationId": "getReport",
        "summary": "Get report metadata",
        "description": "Requires reports:read. Reads existing published content only; no new generation.",
        "x-required-scope": "reports:read",
        "parameters": [
          {
            "name": "id",
            "description": "Report ID from the directory.",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{24}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "report"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "report": {
                      "$ref": "#/components/schemas/Report"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Authorization, input, content or quota error; Retry-After may be present.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "error"
                  ],
                  "properties": {
                    "ok": {
                      "const": false
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/reports/{id}/download": {
      "get": {
        "operationId": "downloadReport",
        "summary": "Download original PDF",
        "description": "Requires reports:download. Reads existing published content only; no new generation.",
        "x-required-scope": "reports:download",
        "parameters": [
          {
            "name": "id",
            "description": "Report ID from the directory.",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{24}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized file bytes (maximum 256 MiB), not a URL. Actual MIME is PDF, text/Markdown, JSON, JPEG, PNG or WebP.",
            "headers": {
              "Content-Length": {
                "schema": {
                  "type": "integer"
                }
              },
              "Content-Type": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "default": {
            "description": "Authorization, input, content or quota error; Retry-After may be present.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "error"
                  ],
                  "properties": {
                    "ok": {
                      "const": false
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/reports/{id}/artifacts": {
      "get": {
        "operationId": "listArtifacts",
        "summary": "List available published materials",
        "description": "Requires artifacts:read. Reads existing published content only; no new generation.",
        "x-required-scope": "artifacts:read",
        "parameters": [
          {
            "name": "id",
            "description": "Report ID from the directory.",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{24}$"
            }
          },
          {
            "name": "cursor",
            "description": "Opaque cursor; preserve filters.",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          },
          {
            "name": "limit",
            "description": "Rows per page.",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "kind",
            "description": "Artifact category.",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "text",
                "image",
                "chart",
                "metadata",
                "translation",
                "article",
                "pdf"
              ]
            }
          },
          {
            "name": "language",
            "description": "Language identifier, for example zh, en or und.",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "items",
                    "next_cursor"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Artifact"
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Authorization, input, content or quota error; Retry-After may be present.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "error"
                  ],
                  "properties": {
                    "ok": {
                      "const": false
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/reports/{id}/artifacts/{artifactId}": {
      "get": {
        "operationId": "downloadArtifact",
        "summary": "Read or download material",
        "description": "Requires artifacts:read. Reads existing published content only; no new generation.",
        "x-required-scope": "artifacts:read",
        "parameters": [
          {
            "name": "id",
            "description": "Report ID from the directory.",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{24}$"
            }
          },
          {
            "name": "artifactId",
            "description": "Artifact ID returned by this report's material list.",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,159}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized file bytes (maximum 256 MiB), not a URL. Actual MIME is PDF, text/Markdown, JSON, JPEG, PNG or WebP.",
            "headers": {
              "Content-Length": {
                "schema": {
                  "type": "integer"
                }
              },
              "Content-Type": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/webp": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "default": {
            "description": "Authorization, input, content or quota error; Retry-After may be present.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "error"
                  ],
                  "properties": {
                    "ok": {
                      "const": false
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "KCD_API_KEY goes in Authorization, never in a URL."
      }
    },
    "schemas": {
      "Report": {
        "type": "object",
        "required": [
          "id",
          "title",
          "title_zh",
          "title_en",
          "institution",
          "date",
          "pdf_listed",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "title_zh": {
            "type": "string"
          },
          "title_en": {
            "type": "string"
          },
          "institution": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "processed_updated_at": {
            "type": "string"
          },
          "page_count": {
            "type": "integer",
            "minimum": 0
          },
          "pdf_listed": {
            "type": "boolean"
          },
          "pdf_available": {
            "type": "boolean"
          },
          "source": {
            "enum": [
              "catalog",
              "processed"
            ]
          }
        }
      },
      "Artifact": {
        "type": "object",
        "required": [
          "id",
          "report_id",
          "kind",
          "language",
          "mime_type",
          "size"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "report_id": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "mime_type": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "text_scope": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "text",
              "image",
              "chart",
              "metadata",
              "translation",
              "article",
              "pdf"
            ]
          },
          "size": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "page_number": {
            "type": "integer"
          }
        }
      }
    }
  }
}
